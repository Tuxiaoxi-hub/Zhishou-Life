<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="zhishoulife.system.mapper.StudyCertificateLanguageMapper">
    
    <resultMap type="StudyCertificateLanguage" id="StudyCertificateLanguageResult">
        <result property="id"    column="id"    />
        <result property="certName"    column="cert_name"    />
        <result property="content"    column="content"    />
        <result property="examTime"    column="exam_time"    />
        <result property="skill"    column="skill"    />
        <result property="createTime"    column="create_time"    />
        <result property="status"    column="STATUS"    />
    </resultMap>

    <sql id="selectStudyCertificateLanguageVo">
        select id, cert_name, content, exam_time, skill, create_time, STATUS from study_certificate_language
    </sql>

    <select id="selectStudyCertificateLanguageList" parameterType="StudyCertificateLanguage" resultMap="StudyCertificateLanguageResult">
        <include refid="selectStudyCertificateLanguageVo"/>
        <where>  
            <if test="certName != null  and certName != ''"> and cert_name like concat('%', #{certName}, '%')</if>
            <if test="status != null "> and STATUS = #{status}</if>
        </where>
    </select>
    
    <select id="selectStudyCertificateLanguageById" parameterType="Long" resultMap="StudyCertificateLanguageResult">
        <include refid="selectStudyCertificateLanguageVo"/>
        where id = #{id}
    </select>

    <insert id="insertStudyCertificateLanguage" parameterType="StudyCertificateLanguage" useGeneratedKeys="true" keyProperty="id">
        insert into study_certificate_language
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="certName != null and certName != ''">cert_name,</if>
            <if test="content != null">content,</if>
            <if test="examTime != null">exam_time,</if>
            <if test="skill != null">skill,</if>
            <if test="createTime != null">create_time,</if>
            <if test="status != null">STATUS,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="certName != null and certName != ''">#{certName},</if>
            <if test="content != null">#{content},</if>
            <if test="examTime != null">#{examTime},</if>
            <if test="skill != null">#{skill},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="status != null">#{status},</if>
         </trim>
    </insert>

    <update id="updateStudyCertificateLanguage" parameterType="StudyCertificateLanguage">
        update study_certificate_language
        <trim prefix="SET" suffixOverrides=",">
            <if test="certName != null and certName != ''">cert_name = #{certName},</if>
            <if test="content != null">content = #{content},</if>
            <if test="examTime != null">exam_time = #{examTime},</if>
            <if test="skill != null">skill = #{skill},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="status != null">STATUS = #{status},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteStudyCertificateLanguageById" parameterType="Long">
        delete from study_certificate_language where id = #{id}
    </delete>

    <delete id="deleteStudyCertificateLanguageByIds" parameterType="String">
        delete from study_certificate_language where id in 
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
</mapper>