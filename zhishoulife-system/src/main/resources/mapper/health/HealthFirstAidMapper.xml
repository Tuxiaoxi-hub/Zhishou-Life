<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="zhishoulife.system.mapper.HealthFirstAidMapper">
    
    <resultMap type="HealthFirstAid" id="HealthFirstAidResult">
        <result property="id"    column="id"    />
        <result property="title"    column="title"    />
        <result property="step"    column="step"    />
        <result property="forbidden"    column="forbidden"    />
        <result property="attention"    column="attention"    />
        <result property="createTime"    column="create_time"    />
        <result property="status"    column="status"    />
    </resultMap>

    <sql id="selectHealthFirstAidVo">
        select id, title, step, forbidden, attention, create_time, status from health_first_aid
    </sql>

    <select id="selectHealthFirstAidList" parameterType="HealthFirstAid" resultMap="HealthFirstAidResult">
        <include refid="selectHealthFirstAidVo"/>
        <where>  
            <if test="title != null  and title != ''"> and title like concat('%', #{title}, '%')</if>
            <if test="status != null "> and status = #{status}</if>
        </where>
    </select>
    
    <select id="selectHealthFirstAidById" parameterType="Long" resultMap="HealthFirstAidResult">
        <include refid="selectHealthFirstAidVo"/>
        where id = #{id}
    </select>

    <insert id="insertHealthFirstAid" parameterType="HealthFirstAid" useGeneratedKeys="true" keyProperty="id">
        insert into health_first_aid
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="title != null and title != ''">title,</if>
            <if test="step != null and step != ''">step,</if>
            <if test="forbidden != null and forbidden != ''">forbidden,</if>
            <if test="attention != null and attention != ''">attention,</if>
            <if test="createTime != null">create_time,</if>
            <if test="status != null">status,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="title != null and title != ''">#{title},</if>
            <if test="step != null and step != ''">#{step},</if>
            <if test="forbidden != null and forbidden != ''">#{forbidden},</if>
            <if test="attention != null and attention != ''">#{attention},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="status != null">#{status},</if>
         </trim>
    </insert>

    <update id="updateHealthFirstAid" parameterType="HealthFirstAid">
        update health_first_aid
        <trim prefix="SET" suffixOverrides=",">
            <if test="title != null and title != ''">title = #{title},</if>
            <if test="step != null and step != ''">step = #{step},</if>
            <if test="forbidden != null and forbidden != ''">forbidden = #{forbidden},</if>
            <if test="attention != null and attention != ''">attention = #{attention},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="status != null">status = #{status},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteHealthFirstAidById" parameterType="Long">
        delete from health_first_aid where id = #{id}
    </delete>

    <delete id="deleteHealthFirstAidByIds" parameterType="String">
        delete from health_first_aid where id in 
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
</mapper>